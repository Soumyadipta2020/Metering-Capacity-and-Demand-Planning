# ─── IMSERV Platform Environment Configuration ───────────────────
# Copy to .env and populate before running

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-long-random-string

# Database (optional — leave blank to use file-based CSV storage)
DATABASE_URL=

# AI / LLM Integration (optional — for AI recommendation engine)
OPENAI_API_KEY=

# Feature Flags
ENABLE_AI_RECOMMENDATIONS=false
ENABLE_DATABASE=false
ENABLE_EXPORT=true

# Data Paths (defaults to ./data — override for cloud storage)
DATA_DIR=./data

# Render.com / Production
PORT=5000
